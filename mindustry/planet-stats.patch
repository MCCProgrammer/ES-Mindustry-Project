+    /** Updates planet statistics for time played and distance walked. */
+    private void updatePlanetStats(float delta){
+        if(state.rules.planet == null || !state.isGame() || state.isPaused() || net.client()) return;
+        
+        PlanetStats stats = state.rules.planet.getStats();
+        
+        // Track time played (delta is in seconds, convert to milliseconds)
+        long deltaTime = (long)(delta * 1000f);
+        stats.timePlayed += deltaTime;
+        
+        // Track distance walked by player units
+        if(player != null && player.unit() != null && player.unit().isValid()){
+            Unit unit = player.unit();
+            float x = unit.x;
+            float y = unit.y;
+            
+            if(lastPosInitialized){
+                // Calculate distance moved
+                float dx = x - lastPlayerX;
+                float dy = y - lastPlayerY;
+                float distance = (float)Math.sqrt(dx * dx + dy * dy);
+                
+                // Only count significant movement (filter out tiny jitter)
+                if(distance > 0.1f){
+                    stats.distanceWalked += distance;
+                }
+            }
+            
+            lastPlayerX = x;
+            lastPlayerY = y;
+            lastPosInitialized = true;
+        }else{
+            // Reset tracking if player unit is invalid
+            lastPosInitialized = false;
+        }
+        
+        // Save stats periodically (every 2 seconds to avoid too frequent saves but ensure data persistence)
+        if(state.tick % 120 == 0){
+            state.rules.planet.saveStats();
+        }
+    }
+
